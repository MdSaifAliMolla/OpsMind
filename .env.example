GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# LLM provider: gemini (default) or openai_compat (vLLM, Ollama, AgentGate, LiteLLM).
# openai_compat needs BASE_URL + MODEL; API key optional (local servers use "none").
OPSMIND_LLM_PROVIDER=gemini
OPSMIND_LLM_BASE_URL=
OPSMIND_LLM_MODEL=
OPSMIND_LLM_API_KEY=
# Agent mode: single (sequential) | multi (parallel investigators) | debate (dual RCA + judge).
# See docs/eval/ABLATION.md — report the table honestly before changing the default.
OPSMIND_MODE=single
# Attach truncated prompts/completions to OTel spans. Default false (counts only).
# See docs/TRACING.md.
OPSMIND_TRACE_CONTENT=false
# Approval hardening (see docs/APPROVAL.md):
# minutes a paused approval stays valid (0 = never expires); require X-Approver identity.
OPSMIND_APPROVAL_TTL_MIN=60
OPSMIND_REQUIRE_APPROVER=false
# Public-demo shield (see DEPLOY.md option B): per-IP POSTs/min, 0 = off.
OPSMIND_RATE_LIMIT_PER_MIN=0
# Optional: Voyage embeddings (if unset, local sentence-transformers is used,
# with hash fallback offline). Never commit real keys.
VOYAGE_API_KEY=

# --- Infra  ---
DATABASE_URL=postgres://opsmind:opsmind@localhost:5432/opsmind

OPSMIND_CHECKPOINTER=auto
QDRANT_URL=http://localhost:6333
MLFLOW_TRACKING_URI=http://localhost:5000
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

OPSMIND_EXECUTE=false
OPSMIND_NAMESPACE=default
# Optional shared-secret auth: when set, clients must send X-API-Key.
# Also required on /incidents/alertmanager when OPSMIND_ALERTMANAGER_KEY is set
# (defaults to OPSMIND_API_KEY if unset).
OPSMIND_API_KEY=
OPSMIND_ALERTMANAGER_KEY=
OPSMIND_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 1 = load embeddings from the local HF cache only (fast, no Hub stalls).
# The docker image pre-downloads the model at build time, so compose sets this.
HF_HUB_OFFLINE=0

# --- Notifications / tracing  ---
SLACK_WEBHOOK_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST takes precedence; LANGFUSE_BASE_URL is kept for backwards compat.
LANGFUSE_HOST=
LANGFUSE_BASE_URL=

HF_TOKEN=

PORT=4000
